# Test Environment Configuration
# This file is used for running tests with Docker services

# Database Configuration
DATABASE_URL=postgresql://rustforge:testpass@localhost:5432/rustforge_test
TEST_DATABASE_URL=postgresql://rustforge:testpass@localhost:5432/rustforge_test

# Redis Configuration
REDIS_URL=redis://:testpass@localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=testpass
REDIS_DB=0

# Cache Configuration
CACHE_DRIVER=redis
CACHE_PREFIX=rustforge_test

# Queue Configuration
QUEUE_DRIVER=redis
QUEUE_CONNECTION=redis
QUEUE_PREFIX=rustforge_test_queue

# Mail Configuration
MAIL_DRIVER=smtp
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=test@rustforge.dev
MAIL_FROM_NAME="RustForge Test"

# S3/MinIO Configuration
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin123
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=test-bucket
AWS_ENDPOINT=http://localhost:9000
AWS_USE_PATH_STYLE_ENDPOINT=true

# Application Configuration
APP_ENV=testing
APP_DEBUG=true
APP_LOG_LEVEL=debug

# Test Configuration
TEST_REDIS_AVAILABLE=true
TEST_DATABASE_AVAILABLE=true
TEST_S3_AVAILABLE=true
TEST_MAIL_AVAILABLE=true
