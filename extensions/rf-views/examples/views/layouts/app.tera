<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}{{ config.app_name | default(value="RustForge App") }}{% endblock %}</title>
    <link rel="stylesheet" href="{{ asset(path='css/app.css') | default(value='/css/app.css') }}">
    {% block styles %}{% endblock %}
</head>
<body>
    {% include "partials/nav" ignore missing %}

    <main class="container">
        {% if flash(key='success') %}
            <div class="alert alert-success" role="alert">
                <button type="button" class="close" data-dismiss="alert">&times;</button>
                {{ flash(key='success') }}
            </div>
        {% endif %}

        {% if flash(key='error') %}
            <div class="alert alert-danger" role="alert">
                <button type="button" class="close" data-dismiss="alert">&times;</button>
                {{ flash(key='error') }}
            </div>
        {% endif %}

        {% if flash(key='warning') %}
            <div class="alert alert-warning" role="alert">
                <button type="button" class="close" data-dismiss="alert">&times;</button>
                {{ flash(key='warning') }}
            </div>
        {% endif %}

        {% if flash(key='info') %}
            <div class="alert alert-info" role="alert">
                <button type="button" class="close" data-dismiss="alert">&times;</button>
                {{ flash(key='info') }}
            </div>
        {% endif %}

        {% block content %}{% endblock %}
    </main>

    {% include "partials/footer" ignore missing %}

    <script src="{{ asset(path='js/app.js') | default(value='/js/app.js') }}"></script>
    {% block scripts %}{% endblock %}
</body>
</html>
