{% extends "layouts/app" %}

{% block title %}Edit Post: {{ post.title }}{% endblock %}

{% block content %}
    <div class="form-container">
        <h1>Edit Post</h1>

        <form method="POST" action="/posts/{{ post.id }}" class="post-form">
            <input type="hidden" name="csrf_token" value="{{ csrf_token() }}">
            <input type="hidden" name="_method" value="PUT">

            <div class="form-group">
                <label for="title">Title <span class="required">*</span></label>
                <input
                    type="text"
                    name="title"
                    id="title"
                    class="form-control{% if error(field='title') %} is-invalid{% endif %}"
                    value="{{ old(key='title') | default(value=post.title) }}"
                    placeholder="Enter post title"
                    required
                    autofocus
                >
                {% if error(field='title') %}
                    <span class="error-message">{{ error(field='title') }}</span>
                {% endif %}
            </div>

            <div class="form-group">
                <label for="body">Content <span class="required">*</span></label>
                <textarea
                    name="body"
                    id="body"
                    rows="15"
                    class="form-control{% if error(field='body') %} is-invalid{% endif %}"
                    placeholder="Write your post content here..."
                    required
                >{{ old(key='body') | default(value=post.body) }}</textarea>
                {% if error(field='body') %}
                    <span class="error-message">{{ error(field='body') }}</span>
                {% endif %}
                <small class="form-text">Markdown is supported</small>
            </div>

            <div class="form-group">
                <label for="tags">Tags</label>
                <input
                    type="text"
                    name="tags"
                    id="tags"
                    class="form-control{% if error(field='tags') %} is-invalid{% endif %}"
                    value="{{ old(key='tags') | default(value=post.tags | join(sep=', ')) }}"
                    placeholder="Separate tags with commas"
                >
                {% if error(field='tags') %}
                    <span class="error-message">{{ error(field='tags') }}</span>
                {% endif %}
                <small class="form-text">Example: rust, web, programming</small>
            </div>

            <div class="form-group">
                <label for="published">
                    <input
                        type="checkbox"
                        name="published"
                        id="published"
                        value="1"
                        {% if old(key='published') == "1" or (not old(key='published') and post.published) %}checked{% endif %}
                    >
                    Published
                </label>
            </div>

            <div class="form-actions">
                <button type="submit" class="btn btn-primary">Update Post</button>
                <a href="/posts/{{ post.id }}" class="btn btn-secondary">Cancel</a>
            </div>
        </form>
    </div>
{% endblock %}
